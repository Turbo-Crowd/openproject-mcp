{
  "name": "@turbo-crowd/openproject-mcp",
  "version": "0.6.0",
  "description": "General-purpose OpenProject API v3 MCP server with policy-gated writes",
  "mcpName": "io.github.Turbo-Crowd/openproject-mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Turbo-Crowd/openproject-mcp.git"
  },
  "homepage": "https://github.com/Turbo-Crowd/openproject-mcp#readme",
  "bugs": {
    "url": "https://github.com/Turbo-Crowd/openproject-mcp/issues"
  },
  "type": "module",
  "bin": {
    "openproject-mcp": "dist/openproject-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build scripts/server.ts --target=node --outfile dist/openproject-mcp.js --banner '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun run test",
    "prepack": "bun run check && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
