# Minimal native-mode configuration
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_TOKEN=<set-in-client-environment>

# Optional runtime settings
# OPENPROJECT_AUTHORIZATION_MODE=native
# OPENPROJECT_AUTH_MODE=basic
# OPENPROJECT_TIMEOUT_MS=30000
# OPENPROJECT_PAGE_SIZE=25
# OPENPROJECT_ALLOWED_UPLOAD_DIRS=/absolute/upload/root

# Advanced restricted-mode policy. Set OPENPROJECT_AUTHORIZATION_MODE=restricted
# before using these controls. Legacy configurations with any of these settings
# and no mode remain restricted for backward compatibility.
# OPENPROJECT_WRITE_ENABLED=true
# OPENPROJECT_ALLOWED_PROJECT_IDS=101
# OPENPROJECT_ALLOWED_WORK_PACKAGE_TYPE_IDS=1
# OPENPROJECT_ALLOWED_WRITE_TOOLS=create_work_package,update_work_package
# OPENPROJECT_ALLOW_DESTRUCTIVE=false
# OPENPROJECT_MODULE_EVIDENCE=[]
# OPENPROJECT_MEMBERSHIP_WRITE_POLICY={"allowedCreateProjectIds":[],"allowedUpdateProjectIds":[],"allowedDeleteProjectIds":[]}
# OPENPROJECT_MEMBERSHIP_PROTECTION={"protectedProjectIds":[],"protectedMembershipIds":[],"lastAdminMembershipIds":[]}
# OPENPROJECT_AUDIT_ENABLED=true
